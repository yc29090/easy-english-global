{
  "name": "easy-english-global",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "admin:create": "node scripts/admin.ts",
    "admin:check": "node scripts/admin-check.ts",
    "content:import": "node --env-file-if-exists=.env scripts/import.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "content:validate": "node scripts/validate-content.ts",
    "start:render": "node scripts/render-start.ts",
    "config:check": "node --env-file-if-exists=.env scripts/check-env.ts",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts",
    "test:mobile": "playwright test --config=playwright.config.ts",
    "test:runtime": "node scripts/check-runtime.ts",
    "test:admin-terminal": "python3 tests/admin-terminal-pty.py",
    "ogden:preview": "node scripts/ogden-preview.ts",
    "ogden:validate": "node scripts/validate-ogden.ts",
    "test:ogden:mobile": "playwright test --config=playwright.ogden.config.ts --project=android-chromium && playwright test --config=playwright.ogden.config.ts --project=iphone-viewport-chromium && playwright test --config=playwright.ogden.config.ts --project=iphone-webkit",
    "ogden:readiness": "node scripts/ogden-readiness.ts",
    "ogden:review-export": "node scripts/ogden-readiness.ts --export-review",
    "ogden:coverage": "node scripts/ogden-coverage.ts",
    "ogden:backup-drill": "node scripts/ogden-backup-drill.ts",
    "ogden:final-audit": "node scripts/ogden-final-audit.ts"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/nodemailer": "^7.0.3",
    "typescript": "^5.9.3",
    "linkedom": "^0.18.12",
    "yaml": "^2.8.1"
  }
}
