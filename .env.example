# Local development only. Copy to .env (ignored) and fill your own PostgreSQL URL.
DATABASE_URL=
DATABASE_SSL=disable
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development
ALLOW_MOCK_CHECKOUT=false
# Render free services: use HTTPS mail delivery, not standard SMTP ports.
# Production defaults to resend; use a verified sender and an API key kept in Render.
MAIL_PROVIDER=disabled
MAIL_FROM=
RESEND_API_KEY=
# Optional SMTP for environments that allow outbound SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional custom PostgreSQL CA certificate (PEM), never disable certificate verification.
DATABASE_CA_CERT=

# Keep disabled until QR ownership, sender authorization, real delivery and security acceptance.
MANUAL_PAYMENT_ENABLED=false
MANUAL_PAYMENT_ACCEPTANCE_VERIFIED=false

# Google OAuth Web client; configure both securely while MAIL_PROVIDER stays disabled.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Callback: APP_URL/api/admin/mail/gmail/callback
